# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# Use standard replica set or single node URI (e.g., mongodb://127.0.0.1:27017/everest_textile_os?replicaSet=rs0)
MONGODB_URI=mongodb://127.0.0.1:27017/everest_textile_os

# Authentication
JWT_SECRET=super_secret_everest_textile_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=everest_os_jwt

# IoT and AI service endpoints (pluggable stubs for future defect detection)
IOT_DEFECT_SCANNER_URL=http://localhost:8080/scanner
AI_QUALITY_SERVICE_URL=http://localhost:8081/vision-qc

